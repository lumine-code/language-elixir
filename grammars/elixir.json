{
  "name": "Elixir",
  "scopeName": "source.elixir",
  "type": "tree-sitter",
  "parser": "tree-sitter-elixir",
  "injectionNames": ["elixir"],
  "fileTypes": ["ex", "exs"],
  "firstLineRegex": "^#![ \\t]*(?:(?:[^\\s]+[\\\\/])?(?:elixir(?:\\.bat)?)|(?:[^\\s]+[\\\\/])?env(?:\\.exe)?[ \\t]+(?:-S[ \\t]+)?(?:elixir(?:\\.bat)?))(?:[ \\t\\r\\n]|$)",
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:elixir-lang/tree-sitter-elixir#549a016863d32733e3ec0e6d47a05d8f8076d2d6",
    "wasmBuildTool": "tree-sitter-cli#v0.27.2",
    "grammar": "elixir.wasm",
    "highlightsQuery": "elixir-highlights.scm",
    "injectionsQuery": "elixir-injections.scm",
    "tagsQuery": "elixir-tags.scm",
    "indentsQuery": "elixir-indents.scm",
    "contentEditPolicies": {
      "content-words": "../lib/content-edit-policy.js"
    }
  }
}
